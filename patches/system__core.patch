+// A controller description alone does not mean that its filesystem was mounted.
+// Pre-cgroup2 devices use a dedicated cpuacct hierarchy for process tracking,
+// keeping it independent of CPU scheduling and memory-limit migrations.
+static bool GetProcessGroupHierarchy(std::string* path, bool* v2) {
+    struct statfs fs;
+    if (CgroupGetControllerPath(CGROUPV2_HIERARCHY_NAME, path) &&
+        statfs(path->c_str(), &fs) == 0 && fs.f_type == CGROUP2_SUPER_MAGIC) {
+        *v2 = true;
+        return true;
+    }
+    if (CgroupGetControllerPath("cpuacct", path) && statfs(path->c_str(), &fs) == 0 &&
+        fs.f_type == CGROUP_SUPER_MAGIC) {
+        *v2 = false;
+        return true;
+    }
+    errno = ENODEV;
+    return false;
+}
