+/* Copyright (C) 2026 Tab S3 ROM Builder
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server;
+
+import static android.net.BpfNetMapsConstants.IIF_MATCH;
+import static android.net.BpfNetMapsConstants.UID_RULES_CONFIGURATION_KEY;
+import static android.net.BpfNetMapsUtils.getMatchByFirewallChain;
+import static android.net.BpfNetMapsUtils.isFirewallAllowList;
+import static android.net.ConnectivityManager.FIREWALL_RULE_ALLOW;
+import static android.net.ConnectivityManager.FIREWALL_RULE_DENY;
+import static android.system.OsConstants.EIO;
+import static android.system.OsConstants.ENODEV;
+
+import android.net.INetd;
+import android.net.UidOwnerValue;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import android.os.SystemProperties;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.util.Log;
+import com.android.net.module.util.MemoryBpfMap;
+import com.android.net.module.util.Struct.S32;
+import com.android.net.module.util.Struct.U32;
+import com.android.net.module.util.Struct.U8;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/** Mirrors Android policy to netd's owner match backend before updating userspace state. */
+final class LegacyNetworkPolicy {
+    static boolean enabled() {
+        return !SystemProperties.getBoolean("ro.kernel.ebpf.supported", true);
+    }
+    private final INetd mNetd;
+    private final Map<Integer, String> mIfaces = new HashMap<>();
+    LegacyNetworkPolicy(INetd netd) { mNetd = Objects.requireNonNull(netd); }
+    private interface NetdAction { void run() throws RemoteException; }
+    private void enforce(NetdAction action) throws ErrnoException {
+        try {
+            action.run();
+        } catch (ServiceSpecificException e) {
+            throw new ErrnoException("legacy netd policy", e.errorCode, e);
+        } catch (RemoteException e) {
+            throw new ErrnoException("legacy netd policy", EIO, e);
+        }
+    }
+
+    private static final class Change {
+        final NetdAction apply;
+        final NetdAction undo;
+        Change(NetdAction apply, NetdAction undo) { this.apply = apply; this.undo = undo; }
+    }
+
+    private void enforceChanges(List<Change> changes) throws ErrnoException {
+        int applied = 0;
+        try {
+            for (Change change : changes) {
+                enforce(change.apply);
+                applied++;
+            }
+        } catch (ErrnoException error) {
+            for (int i = applied - 1; i >= 0; i--) {
+                try {
+                    enforce(changes.get(i).undo);
+                } catch (ErrnoException rollbackError) {
+                    error.addSuppressed(rollbackError);
+                    Log.wtf("LegacyNetworkPolicy", "Failed to restore netd policy", rollbackError);
+                }
+            }
+            throw error;
+        }
+    }
+
+    MemoryBpfMap<S32, U32> configurationMap() {
+        return new MemoryBpfMap<>((key, oldValue, newValue) -> {
+            if (!key.equals(UID_RULES_CONFIGURATION_KEY)) return;
+            long oldRules = oldValue == null ? 0 : oldValue.val;
+            long newRules = newValue == null ? 0 : newValue.val;
+            List<Change> changes = new ArrayList<>();
+            for (int chain = 1; chain <= 9; chain++) {
+                long match = getMatchByFirewallChain(chain);
+                if (((oldRules ^ newRules) & match) == 0) continue;
+                final int child = chain;
+                final boolean enable = (newRules & match) != 0;
+                changes.add(new Change(
+                        () -> mNetd.firewallEnableChildChain(child, enable),
+                        () -> mNetd.firewallEnableChildChain(child, !enable)));
+            }
+            enforceChanges(changes);
+        });
+    }
+
+    MemoryBpfMap<S32, UidOwnerValue> ownerMap() {
+        return new MemoryBpfMap<>((key, oldValue, newValue) -> {
+            final int uid = key.val;
+            long oldRules = oldValue == null ? 0 : oldValue.rule;
+            long newRules = newValue == null ? 0 : newValue.rule;
+            List<Change> changes = new ArrayList<>();
+            for (int chain = 1; chain <= 12; chain++) {
+                long match = getMatchByFirewallChain(chain);
+                if (((oldRules ^ newRules) & match) == 0) continue;
+                final int child = chain;
+                boolean present = (newRules & match) != 0;
+                final int rule = present == isFirewallAllowList(chain)
+                        ? FIREWALL_RULE_ALLOW : FIREWALL_RULE_DENY;
+                final boolean wasPresent = (oldRules & match) != 0;
+                final int oldRule = wasPresent == isFirewallAllowList(chain)
+                        ? FIREWALL_RULE_ALLOW : FIREWALL_RULE_DENY;
+                changes.add(new Change(
+                        () -> mNetd.firewallSetUidRule(child, uid, rule),
+                        () -> mNetd.firewallSetUidRule(child, uid, oldRule)));
+            }
+            int oldIif = (oldRules & IIF_MATCH) != 0 ? oldValue.iif : 0;
+            int newIif = (newRules & IIF_MATCH) != 0 ? newValue.iif : 0;
+            String newIface = null;
+            if (oldIif != newIif) {
+                // Keep the previous name for rollback even after its interface disappears.
+                final String oldIface = mIfaces.get(uid);
+                newIface = newIif == 0 ? null : Os.if_indextoname(newIif);
+                if (newIif != 0 && newIface == null) {
+                    throw new ErrnoException("legacy interface", ENODEV);
+                }
+                final String iface = newIface;
+                changes.add(new Change(
+                        () -> setInterface(uid, iface), () -> setInterface(uid, oldIface)));
+            }
+            enforceChanges(changes);
+            if (oldIif != newIif) {
+                if (newIface == null) mIfaces.remove(uid);
+                else mIfaces.put(uid, newIface);
+            }
+            // VPN lockdown uses netd.networkRejectNonSecureVpn routing rules,
+            // which remain enforced independently of the BPF policy mirror.
+        });
+    }
+
+    private void setInterface(int uid, String iface) throws RemoteException {
+        if (iface == null) mNetd.firewallRemoveUidInterfaceRules(new int[] {uid});
+        else mNetd.firewallAddUidInterfaceRules(iface, new int[] {uid});
+    }
+
+    MemoryBpfMap<S32, U8> dataSaverMap() {
+        return new MemoryBpfMap<>((key, oldValue, newValue) -> {
+            final boolean enable = newValue != null && newValue.val != 0;
+            enforce(() -> {
+                if (!mNetd.bandwidthEnableDataSaver(enable)) {
+                    throw new ServiceSpecificException(EIO, "Failed to enforce legacy data saver");
+                }
+            });
+        });
+    }
+
+    MemoryBpfMap<S32, U8> permissionMap() {
+        return new MemoryBpfMap<>((key, oldValue, newValue) -> {
+            final int permission = newValue == null ? 0 : newValue.val;
+            enforce(() -> mNetd.trafficSetNetPermForUids(permission, new int[] {key.val}));
+        });
+    }
+}
