+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include <gtest/gtest.h>
+#include <media/stagefright/MetaData.h>
+#include <media/stagefright/foundation/ABuffer.h>
+#include <media/stagefright/foundation/AMessage.h>
+#include <media/stagefright/foundation/ColorUtils.h>
+#include <mpeg2ts/ESQueue.h>
+#include <vector>
+#include <cstring>
+
+using namespace android;
+
+static std::vector<uint8_t> header(bool description, bool userData = false,
+                                   uint8_t iso = 1, bool extensions = true) {
+    std::vector<uint8_t> bytes = {0, 0, 1, 0xb3, 0x2d, 0x01, 0xe0, 0x13, 0x20, 0, 0x60, 0};
+    if (extensions) {
+        const std::vector<uint8_t> sequence = {0, 0, 1, 0xb5, 0x14, 0x8a, 0, 1, 0, 0};
+        bytes.insert(bytes.end(), sequence.begin(), sequence.end());
+        if (userData) {
+            const std::vector<uint8_t> user = {0, 0, 1, 0xb2, 't', 'e', 's', 't'};
+            bytes.insert(bytes.end(), user.begin(), user.end());
+        }
+        std::vector<uint8_t> display = {0, 0, 1, 0xb5, uint8_t(description ? 0x2b : 0x2a)};
+        if (description) display.insert(display.end(), {iso, iso, iso});
+        display.insert(display.end(), {0x16, 0x84, 0x0f, 0});
+        bytes.insert(bytes.end(), display.begin(), display.end());
+    }
+    const std::vector<uint8_t> gop = {0, 0, 1, 0xb8, 0, 0, 0, 0x40};
+    bytes.insert(bytes.end(), gop.begin(), gop.end());
+    return bytes;
+}
+
+static void checkFormat(ElementaryStreamQueue& queue, bool description, uint8_t iso = 1) {
+    auto format = queue.getFormat();
+    ASSERT_NE(format, nullptr);
+    int32_t value = 0;
+    ASSERT_TRUE(format->findInt32(kKeyWidth, &value));
+    EXPECT_EQ(value, 720);
+    ASSERT_TRUE(format->findInt32(kKeyHeight, &value));
+    EXPECT_EQ(value, 480);
+    const uint32_t keys[] = {kKeyColorPrimaries, kKeyTransferFunction, kKeyColorMatrix, kKeyColorRange};
+    ColorAspects expected{};
+    ColorUtils::convertIsoColorAspectsToCodecAspects(iso, iso, iso, false, expected);
+    const int32_t values[] = {static_cast<int32_t>(expected.mPrimaries),
+                             static_cast<int32_t>(expected.mTransfer),
+                             static_cast<int32_t>(expected.mMatrixCoeffs),
+                             static_cast<int32_t>(expected.mRange)};
+    for (size_t i = 0; i < 4; ++i) {
+        EXPECT_EQ(format->findInt32(keys[i], &value), description);
+        if (description) EXPECT_EQ(value, values[i]);
+    }
+}
+
+static void checkSplits(bool description, bool userData, uint8_t iso, bool extensions = true) {
+    auto bytes = header(description, userData, iso, extensions);
+    for (size_t split = 4; split < bytes.size(); ++split) {
+        SCOPED_TRACE(split);
+        ElementaryStreamQueue queue(ElementaryStreamQueue::MPEG_VIDEO);
+        ASSERT_EQ(queue.appendData(bytes.data(), split, 0), OK);
+        (void)queue.dequeueAccessUnit();
+        ASSERT_EQ(queue.appendData(bytes.data() + split, bytes.size() - split, 0), OK);
+        (void)queue.dequeueAccessUnit();
+        checkFormat(queue, description, iso);
+    }
+}
+
+TEST(Mpeg2Color, Bt709EverySplit) { checkSplits(true, false, 1); }
+TEST(Mpeg2Color, Bt601EverySplit) { checkSplits(true, false, 6); }
+TEST(Mpeg2Color, AbsentDescriptionEverySplit) { checkSplits(false, false, 1); }
+TEST(Mpeg2Color, UserDataBeforeDisplayExtension) { checkSplits(true, true, 1); }
+TEST(Mpeg2Color, Mpeg1WithoutExtensions) { checkSplits(false, false, 1, false); }
+
+TEST(Mpeg2Color, InitialUserDataStaysInFirstAccessUnit) {
+    auto bytes = header(true, true);
+    const std::vector<uint8_t> pictures = {0, 0, 1, 0, 0, 8, 0, 0, 0, 0, 1, 0, 0, 8, 0, 0};
+    bytes.insert(bytes.end(), pictures.begin(), pictures.end());
+    ElementaryStreamQueue queue(ElementaryStreamQueue::MPEG_VIDEO);
+    ASSERT_EQ(queue.appendData(bytes.data(), bytes.size(), 0), OK);
+    (void)queue.dequeueAccessUnit();
+    auto unit = queue.dequeueAccessUnit();
+    ASSERT_NE(unit, nullptr);
+    ASSERT_GE(unit->size(), 8u);
+    EXPECT_EQ(memcmp(unit->data(), "\x00\x00\x01\xb2test", 8), 0);
+    sp<ABuffer> positions;
+    ASSERT_TRUE(unit->meta()->findBuffer("mpeg-user-data", &positions));
+    ASSERT_EQ(positions->size(), sizeof(size_t));
+    size_t position = 1;
+    memcpy(&position, positions->data(), sizeof(position));
+    EXPECT_EQ(position, 0u);
+}
