index 0000000000000000000000000000000000000000..ffc078ff9715ad516e28e40c0f1b4d3055a5b6e2
--- /dev/null
+++ b/mm-audio/aenc-aac/qdsp6/inc/Map.h
@@ -0,0 +1,243 @@
