+# limitations under the License.
+
+# SM-T820 uses boot header v0 with appended device trees. Its Samsung
+# bootloader also expects the marker preserved by hardware/samsung on LOS 21.
+$(INSTALLED_BOOTIMAGE_TARGET): $(MKBOOTIMG) $(INTERNAL_BOOTIMAGE_FILES) $(BOOTIMAGE_EXTRA_DEPS) $(INSTALLED_KERNEL_TARGET) $(COMMON_PATH)/write_samsung_boot_id.py
+	$(call pretty,"Target Samsung boot image: $@")
+	$(hide) $(MKBOOTIMG) --kernel $(call bootimage-to-kernel,$@) $(INTERNAL_BOOTIMAGE_ARGS) $(INTERNAL_MKBOOTIMG_VERSION_ARGS) $(BOARD_MKBOOTIMG_ARGS) --output $@
+	$(hide) /usr/bin/python3 $(COMMON_PATH)/write_samsung_boot_id.py $@
+	$(hide) printf SEANDROIDENFORCE >> $@
+	$(hide) $(call assert-max-image-size,$@,$(BOARD_BOOTIMAGE_PARTITION_SIZE),raw)
+
+$(INSTALLED_RECOVERYIMAGE_TARGET): $(MKBOOTIMG) $(recovery_ramdisk) $(recovery_kernel) $(RECOVERYIMAGE_EXTRA_DEPS) $(COMMON_PATH)/write_samsung_boot_id.py
+	$(call pretty,"Target Samsung recovery image: $@")
+	$(hide) $(MKBOOTIMG) $(INTERNAL_RECOVERYIMAGE_ARGS) $(INTERNAL_MKBOOTIMG_VERSION_ARGS) $(BOARD_MKBOOTIMG_ARGS) --output $@
+	$(hide) /usr/bin/python3 $(COMMON_PATH)/write_samsung_boot_id.py $@
+	$(hide) printf SEANDROIDENFORCE >> $@
+	$(hide) $(call assert-max-image-size,$@,$(BOARD_RECOVERYIMAGE_PARTITION_SIZE),raw)
diff --git a/configs/apexd-recovery.rc b/configs/apexd-recovery.rc
new file mode 100644
index 0000000000000000000000000000000000000000..2afc3c309aa0acc9b532025044a69a29e1f27d7b
--- /dev/null
+++ b/configs/apexd-recovery.rc
@@ -0,0 +1,23 @@
+# Debug builds only. Preserve normal APEX startup and capabilities, but return
+# to TWRP on failure so logs can be collected over USB.+# Samsung's kernel selects recovery for any reboot target starting "recovery".
+# The suffix avoids Android init's BCB write: this tablet has no misc partition.
+
+service apexd /system/bin/apexd
+    override
+    interface aidl apexservice
+    class core
+    user root
+    group system
+    oneshot
+    disabled
+    reboot_on_failure reboot,recovery-no-bcb,apexd-failed
+    capabilities CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER SYS_ADMIN
+
+service apexd-bootstrap /system/bin/apexd --bootstrap
+    override
+    user root
+    group system
+    oneshot
+    disabled
+    reboot_on_failure reboot,recovery-no-bcb,bootstrap-apexd-failed
+    capabilities SYS_ADMIN
diff --git a/configs/bringup-usb.rc b/configs/bringup-usb.rc
new file mode 100644
index 0000000000000000000000000000000000000000..0135be01ae347f4992ba9628e2e9e3f89ba0ab75
--- /dev/null
+++ b/configs/bringup-usb.rc
@@ -0,0 +1,7 @@
+# Enable authenticated USB ADB during this tablet's userdebug bring-up.
+# AdbService later reads this same preference. Property actions may run after
+# the queued boot event, so also select the live USB configuration explicitly.
+# Authentication and the existing authorized public keys remain required.
+on property:ro.persistent_properties.ready=true && property:ro.build.type=userdebug
+    setprop persist.sys.usb.config adb
+    setprop sys.usb.config adb
