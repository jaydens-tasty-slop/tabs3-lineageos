# Local release identities and signing credentials must never enter source Git.
/state/release-signing/
/release-signing/
/signing-keys/
/keys/
*.pk8
*.priv
*.key
*.keystore
*.jks
*.p12
*.pfx
*.private.pem
*.pem
*.password
*.passwords

# Private progress and device evidence stay outside the public source tree.
/local.mk
BUGS.md
CAMERA_HANDOFF.txt
DEVICE_WORKFLOW.md
USB_SESSION_*.md
KERNEL_SMOKE_*.md
PUBLIC_RELEASE.txt
*.log
*.logcat
*.tombstone
