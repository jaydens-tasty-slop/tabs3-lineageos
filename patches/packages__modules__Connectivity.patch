index 0000000000000000000000000000000000000000..4ad5962072b7c16e242bbd560ebdd46596288db7
--- /dev/null
+++ b/staticlibs/device/com/android/net/module/util/MemoryBpfMap.java
@@ -0,0 +1,68 @@
+/* Copyright (C) 2026 Tab S3 ROM Builder
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.net.module.util;
+
+import android.system.ErrnoException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+
+/** Userspace policy state for legacy netd. A listener enforces updates before they commit. */
+public final class MemoryBpfMap<K extends Struct, V extends Struct> implements IBpfMap<K, V> {
+    public interface UpdateListener<K, V> {
+        void update(K key, V oldValue, V newValue) throws ErrnoException;
+    }
+    private final LinkedHashMap<K, V> mValues = new LinkedHashMap<>();
+    private final UpdateListener<K, V> mListener;
+    public MemoryBpfMap() { this(null); }
+    public MemoryBpfMap(UpdateListener<K, V> listener) { mListener = listener; }
+
+    @Override
+    public synchronized void updateEntry(K key, V value) throws ErrnoException {
+        Objects.requireNonNull(key);
+        Objects.requireNonNull(value);
+        if (mListener != null) mListener.update(key, mValues.get(key), value);
+        mValues.put(key, value);
+    }
+    @Override
+    public synchronized void insertEntry(K key, V value) throws ErrnoException {
+        if (mValues.containsKey(key)) throw new IllegalStateException("Key already exists");
+        updateEntry(key, value);
+    }
+    @Override
+    public synchronized void replaceEntry(K key, V value) throws ErrnoException {
+        if (!mValues.containsKey(key)) throw new NoSuchElementException("Key does not exist");
+        updateEntry(key, value);
+    }
+    @Override
+    public synchronized boolean insertOrReplaceEntry(K key, V value) throws ErrnoException {
+        boolean inserted = !mValues.containsKey(key);
+        updateEntry(key, value);
+        return inserted;
+    }
+    @Override
+    public synchronized boolean deleteEntry(K key) throws ErrnoException {
+        if (!mValues.containsKey(key)) return false;
+        if (mListener != null) mListener.update(key, mValues.get(key), null);
+        mValues.remove(key);
+        return true;
+    }
+    @Override
+    public synchronized K getNextKey(K key) throws ErrnoException {
+        ArrayList<K> keys = new ArrayList<>(mValues.keySet());
+        int index = keys.indexOf(key);
+        return index + 1 < keys.size() ? keys.get(index + 1) : null;
+    }
+    @Override
+    public synchronized K getFirstKey() throws ErrnoException {
+        return mValues.isEmpty() ? null : mValues.keySet().iterator().next();
+    }
+    @Override
+    public synchronized boolean containsKey(K key) throws ErrnoException {
+        return mValues.containsKey(key);
+    }
+    @Override
+    public synchronized V getValue(K key) throws ErrnoException { return mValues.get(key); }
+}
