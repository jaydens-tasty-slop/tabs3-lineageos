diff --git a/bpf/netd/LegacyPolicy.cpp b/bpf/netd/LegacyPolicy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..474ec988f174258eb595231a17d781ee481ed313
--- /dev/null
+++ b/bpf/netd/LegacyPolicy.cpp
@@ -0,0 +1,84 @@
+/* Copyright (C) 2026 Tab S3 ROM Builder
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "NetdUpdatablePublic.h"
+
+#include <errno.h>
+#include <array>
+#include <map>
+#include <mutex>
+#include <set>
+
+namespace {
+std::mutex policyLock;
+std::array<std::set<uid_t>, 13> uidChains;
+std::map<uid_t, int32_t> uidPermissions;
+uint32_t enabledChains = 0;
+bool dataSaver = false;
+bool policyReady = false;
+
+bool allowlist(int chain) {
+    return chain == 1 || chain == 3 || chain == 4 || chain == 5 || chain == 6 || chain == 10;
+}
+}
+
+int libnetd_updatable_legacy_setUidChain(int32_t chain, const int32_t* uids, size_t count) {
+    if (chain < 1 || chain > 12 || (count && !uids)) return -EINVAL;
+    std::set<uid_t> replacement;
+    for (size_t i = 0; i < count; i++) {
+        if (uids[i] < 0) return -EINVAL;
+        replacement.insert(static_cast<uid_t>(uids[i]));
+    }
+    std::lock_guard guard(policyLock);
+    uidChains[chain] = std::move(replacement);
+    return 0;
+}
+
+int libnetd_updatable_legacy_setEnabledChains(uint32_t enabled) {
+    if (enabled & ~0x3feU) return -EINVAL; // Child chains 1 through 9.
+    std::lock_guard guard(policyLock);
+    enabledChains = enabled;
+    return 0;
+}
+
+void libnetd_updatable_legacy_setDataSaver(bool enabled) {
+    std::lock_guard guard(policyLock);
+    dataSaver = enabled;
+}
+
+int libnetd_updatable_legacy_setUidPermission(int32_t uid, int32_t permission) {
+    if (uid < 0 || (permission != -1 && (permission & ~12))) return -EINVAL;
+    std::lock_guard guard(policyLock);
+    // The Android permission map is indexed by appId, shared across users.
+    uid_t appId = static_cast<uid_t>(uid) % 100000;
+    if (permission == 0 || permission == -1) uidPermissions.erase(appId);
+    else uidPermissions[appId] = permission;
+    return 0;
+}
+
+bool libnetd_updatable_legacy_canTagOtherUid(uid_t uid) {
+    if (uid < 10000) return true;
+    std::lock_guard guard(policyLock);
+    auto permission = uidPermissions.find(uid % 100000);
+    return permission != uidPermissions.end() && (permission->second & 8); // UPDATE_DEVICE_STATS.
+}
+
+void libnetd_updatable_legacy_setReady(bool ready) {
+    std::lock_guard guard(policyLock);
+    policyReady = ready;
+}
+
+int libnetd_updatable_legacy_isUidNetworkingBlocked(uid_t uid, bool metered) {
+    std::lock_guard guard(policyLock);
+    if (!policyReady) return -EUNATCH;
+    // Match the system UID exemption in the installed xt_owner chains.
+    if (uid < 10000) return 0;
+    for (int chain = 1; chain <= 9; chain++) {
+        if (!(enabledChains & (1U << chain))) continue;
+        bool present = uidChains[chain].count(uid);
+        if (present != allowlist(chain)) return 1;
+    }
+    if (metered && (uidChains[11].count(uid) || uidChains[12].count(uid) ||
+                   (dataSaver && !uidChains[10].count(uid)))) return 1;
+    return 0;
+}
