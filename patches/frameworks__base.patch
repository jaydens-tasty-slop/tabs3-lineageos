+static int reclaimProcessLegacy(int pid, int compactionFlags) {
+    cancelRunningCompaction.store(false);
+    if (CC_UNLIKELY(cancelRunningCompaction.load())) {
+        return ERROR_COMPACTION_CANCELLED;
+    }
+
+    const bool compactAnon = compactionFlags & COMPACT_ACTION_ANON_FLAG;
+    const bool compactFile = compactionFlags & COMPACT_ACTION_FILE_FLAG;
+    const char* action = compactAnon ? (compactFile ? "all" : "anon") : "file";
+    const std::string path = StringPrintf("/proc/%d/reclaim", pid);
+    unique_fd fd(TEMP_FAILURE_RETRY(open(path.c_str(), O_WRONLY | O_CLOEXEC)));
+    if (fd < 0) {
+        return -errno;
+    }
+    if (!android::base::WriteStringToFd(action, fd)) {
+        return errno == 0 ? -EIO : -errno;
+    }
+    return 0;
+}
