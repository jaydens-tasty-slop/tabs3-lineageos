+    if (!android::base::GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+        // The legacy permission state is populated by the same privileged
+        // permission-map updates as the BPF path.
+        if (chargeUid == static_cast<uid_t>(-1)) chargeUid = realUid;
