+    for (size_t i = 0; i < entry.count; ++i) {
+        configurations.push(entry.data.i32[i]);
+    }
+    for (int32_t format : kFormats) {
+        bool found = false;
+        for (size_t i = 0; i < entry.count; i += 4) {
+            found |= entry.data.i32[i] == format && entry.data.i32[i + 1] == kWidth &&
