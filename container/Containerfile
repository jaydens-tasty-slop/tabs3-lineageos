FROM docker.io/library/ubuntu@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
    bc bison build-essential ca-certificates ccache curl file flex g++-multilib \
    gcc-multilib git gnupg gperf jq lib32ncurses-dev lib32readline-dev \
    lib32z1-dev libarchive-tools libelf-dev liblz4-tool libncurses5 \
    libncurses5-dev libsdl1.2-dev libssl-dev libxml2 libxml2-utils lzop \
    openjdk-17-jdk-headless patch pngcrush python3 python3-pip rsync \
    schedtool squashfs-tools unzip wget xsltproc xz-utils zip zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    git-lfs procps python-is-python3 time \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
