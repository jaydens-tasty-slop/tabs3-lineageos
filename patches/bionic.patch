index be97818da9dd1010dd46c0de1c9313bed30b14ec..e938bf69cadc418cce8c721e840a3e15b180ddbd 100644
--- a/libc/bionic/sys_epoll.cpp
+++ b/libc/bionic/sys_epoll.cpp
@@ -27,6 +27,7 @@
  */
 
 #include <errno.h>
+#include <limits.h>
 #include <sys/epoll.h>
 
 #include "private/SigSetConverter.h"
@@ -80,7 +81,27 @@ int epoll_pwait2_64(int fd, epoll_event* events, int max_events, const timespec*
     kts_ptr = &kts;
   }
 #endif
-  return __epoll_pwait2(fd, events, max_events, kts_ptr, ss, sizeof(*ss));
+  const int result = __epoll_pwait2(fd, events, max_events, kts_ptr, ss, sizeof(*ss));
+  if (result != -1 || errno != ENOSYS) return result;
+
+  // Preserve signal masks and avoid an immediate retry loop on pre-5.11
+  // kernels. Round a fractional millisecond up and clamp instead of
+  // overflowing into epoll_pwait's negative (infinite) timeout range.
+  int timeout_ms = -1;
+  if (timeout != nullptr) {
+    if (timeout->tv_sec < 0 || timeout->tv_nsec < 0 || timeout->tv_nsec >= 1000000000) {
+      errno = EINVAL;
+      return -1;
+    }
+    if (timeout->tv_sec > INT_MAX / 1000) {
+      timeout_ms = INT_MAX;
+    } else {
+      const int64_t ms = static_cast<int64_t>(timeout->tv_sec) * 1000 +
+                         (timeout->tv_nsec + 999999) / 1000000;
+      timeout_ms = ms > INT_MAX ? INT_MAX : static_cast<int>(ms);
+    }
+  }
+  return __epoll_pwait(fd, events, max_events, timeout_ms, ss, sizeof(*ss));
 }
 
