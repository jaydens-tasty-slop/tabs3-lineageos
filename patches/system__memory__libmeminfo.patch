+#if defined(__ANDROID__) && !defined(__ANDROID_APEX__) && !defined(__ANDROID_VNDK__)
+namespace {
+// GPU accounting is optional on kernels without the gpu_mem tracepoint/BPF map.
+// The pathname constructor aborts even on an unavailable map. The fallible init
+// path preserves read-only access and validation of any map that does exist.
+class GpuMemBpfMap final : public bpf::BpfMapRO<uint64_t, uint64_t> {
+  public:
+    android::base::Result<void> init(const char* path) {
+        return bpf::BpfMapRO<uint64_t, uint64_t>::init(
+                path, bpf::mapRetrieveRO(path), /* writable */ false);
+    }
+};
+}  // namespace
+#endif
