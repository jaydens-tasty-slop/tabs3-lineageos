# Allow only reviewed build-root sources. Everything else stays private/local.
/*
!/.gitignore
!/.gitattributes
!/.containerignore
!/Makefile
!/README.md
!/LICENSE
!/NOTICE
!/docs/
/docs/*
!/docs/BUILDING.md
!/docs/KNOWN_ISSUES.md
!/docs/SOURCES.md
!/docs/INSTALLING.md
!/docs/SIGNING.md
!/container/
/container/*
!/container/Containerfile
!/container/DeviceTools.Containerfile
!/container/MediaTools.Containerfile
!/manifests/
/manifests/*
!/manifests/base-source-lock.xml
!/manifests/baseline-vendor-exceptions.json
!/manifests/gts3lwifi.xml
!/patches/
/patches/*
!/patches/*.patch
!/patches/index.json
!/scripts/
/scripts/*
!/scripts/podman.sh
!/scripts/device.sh
!/scripts/device_smoke.sh
!/scripts/device_smoke.py
!/scripts/device_smoke_hardware.sh
!/scripts/device_smoke_hardware.py
!/scripts/device_media_probe.py
!/scripts/device_vulkan_probe.py
!/scripts/device_smoke_common.py
!/scripts/device_sleep_study.py
!/scripts/build_sleep_clock.py
!/scripts/adb_device.py
!/scripts/build_media_payload.py
!/scripts/generate_media_fixtures.py
!/scripts/build_vulkan_validation.py
!/scripts/build_smoke_payloads.sh
!/scripts/build_smoke_payloads.py
!/scripts/setup_checkout.sh
!/scripts/clone_upstreams.py
!/scripts/apply_port.py
!/scripts/build_env.sh
!/scripts/build_rom.sh
!/scripts/package_rom.sh
!/scripts/finalize_rom.sh
!/scripts/audit_release_adb.py
!/scripts/verify_system_payload.py
!/scripts/verify_ota.py
!/scripts/export_port.py
!/scripts/verify_source_export.py
!/device-validation/
/device-validation/*
!/device-validation/media/
!/device-validation/media/**
!/device-validation/native/
/device-validation/native/*
!/device-validation/native/vulkan_compute.c
!/device-validation/native/vulkan_compute.comp
!/device-validation/native/sleep_clock.c

# Local release identities and signing credentials must never enter source Git.
/state/release-signing/
/release-signing/
/signing-keys/
/keys/
*.pk8
*.priv
*.key
*.keystore
*.jks
*.p12
*.pfx
*.private.pem
*.pem
*.password
*.passwords
