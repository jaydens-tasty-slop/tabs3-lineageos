@@ -1456,6 +1456,49 @@ class CameraViewModel(application: Application) : ApertureViewModel(application)
             )
         }
 
+    /**
+     * Fall back to the highest lower video quality after a stream configuration failure.
+     *
+     * Some legacy camera HALs advertise an encoder profile that they cannot expose as a regular
+     * Camera2 stream. Persisting the lower quality prevents the camera from getting stuck in a
+     * launch-and-exit loop while leaving the advertised quality available for future HAL fixes.
+     */
+    fun fallbackVideoQuality(): Boolean {
+        var fallbackApplied = false
+        val updated = updateConfiguration<CameraConfiguration.Video> { cameraConfiguration ->
+            val orderedQualities = listOf(Quality.SD, Quality.HD, Quality.FHD, Quality.UHD)
+            val currentIndex = orderedQualities.indexOf(cameraConfiguration.videoQuality)
+            val videoQuality = cameraConfiguration.camera.supportedVideoQualities.keys
+                .filter { orderedQualities.indexOf(it) in 0 until currentIndex }
+                .maxByOrNull { orderedQualities.indexOf(it) }
+                ?: return@updateConfiguration cameraConfiguration
+
+            val videoQualityInfo = cameraConfiguration.camera.supportedVideoQualities[
+                videoQuality
+            ] ?: return@updateConfiguration cameraConfiguration
+
+            val videoFrameRate = cameraConfiguration.videoFrameRate.takeIf {
+                videoQualityInfo.supportedFrameRates.contains(it)
+            } ?: videoQualityInfo.supportedFrameRates.firstOrNull()
+
+            val videoDynamicRange = cameraConfiguration.videoDynamicRange.takeIf {
+                videoQualityInfo.supportedDynamicRanges.contains(it)
+            } ?: videoQualityInfo.supportedDynamicRanges.firstOrNull()
+                ?: return@updateConfiguration cameraConfiguration
+
+            preferencesRepository.videoQuality.value = videoQuality
+            fallbackApplied = true
+
+            cameraConfiguration.copy(
+                videoQuality = videoQuality,
+                videoFrameRate = videoFrameRate,
+                videoDynamicRange = videoDynamicRange,
+            )
+        }
+
+        return updated && fallbackApplied
+    }
+
     /**
