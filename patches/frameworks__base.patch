+// The release flag may be enabled on devices whose kernel predates these seals.
+// Keep the existing ashmem transport when the native memfd requirements are absent.
+static bool supportsBitmapMemfd() {
+    static const bool supported = [] {
+        base::unique_fd fd(syscall(__NR_memfd_create, "Bitmap transport probe",
+                                  MFD_CLOEXEC | MFD_ALLOW_SEALING));
+        return fd.ok() && fcntl(fd.get(), F_ADD_SEALS,
+                               F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_FUTURE_WRITE) == 0;
+    }();
+    return supported;
+}
