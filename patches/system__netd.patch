+namespace {
+// Android's public ConnectivityManager chain values. Metered chains 10-12
+// are implemented through BandwidthController's happy/penalty boxes.
+const char* legacyChainName(int chain) {
+    static const char* names[] = {nullptr, "fw_dozable", "fw_standby", "fw_powersave",
+        "fw_restricted", "fw_low_power_standby", "fw_background", "fw_oem_deny_1",
+        "fw_oem_deny_2", "fw_oem_deny_3"};
+    return chain > 0 && chain < 10 ? names[chain] : nullptr;
+}
+
+bool legacyAllowlist(int chain) {
+    return chain == 1 || chain == 3 || chain == 4 || chain == 5 || chain == 6 || chain == 10;
+}
+}
+
+int FirewallController::setupLegacyHooks() {
+    mLegacyEnabled.clear();
+    mLegacyUids.clear();
+    mLegacyInterfaces.clear();
+    std::string cmd = "*filter\n:fw_legacy -\n:fw_legacy_iif -\n";
+    for (int chain = 1; chain <= 9; chain++) {
+        StringAppendF(&cmd, ":%s -\n", legacyChainName(chain));
+    }
+    cmd += "COMMIT\n";
+    if (execIptablesRestore(V4V6, cmd) != 0) return -EREMOTEIO;
+    for (int chain = 1; chain <= 9; chain++) {
+        int result = writeLegacyChain(chain);
+        if (result) return result;
+    }
+    if (int error = writeLegacyInterfaces()) return error;
+    if (int error = writeLegacyEnabled()) return error;
+    return attachLegacyHooks();
+}
+
+int FirewallController::attachLegacyHooks() {
+    const std::string cmd = "*filter\n-A fw_INPUT -j fw_legacy_iif\n"
+                            "-A fw_INPUT -j fw_legacy\n-A fw_INPUT -j fw_global_INPUT\n"
+                            "-A fw_OUTPUT -j fw_legacy\n-A fw_OUTPUT -j fw_global_OUTPUT\nCOMMIT\n";
+    return execIptablesRestore(V4V6, cmd) == 0 ? 0 : -EREMOTEIO;
+}
+
+int FirewallController::writeLegacyChain(int chain) {
+    std::string cmd = "*filter\n";
+    if (chain >= 10 && chain <= 12) {
+        cmd += ":bw_penalty_box -\n:bw_happy_box -\n"
+               "-A bw_penalty_box -m owner --uid-owner 0-9999 -j RETURN\n";
+        std::set<int> denied = mLegacyUids[11];
+        denied.insert(mLegacyUids[12].begin(), mLegacyUids[12].end());
+        for (int uid : denied) {
+            StringAppendF(&cmd, "-A bw_penalty_box -m owner --uid-owner %d -j REJECT\n", uid);
+        }
+        cmd += "-A bw_penalty_box -j bw_happy_box\n"
+               "-A bw_happy_box -m owner --uid-owner 0-9999 -j RETURN\n";
+        for (int uid : mLegacyUids[10]) {
+            StringAppendF(&cmd, "-A bw_happy_box -m owner --uid-owner %d -j RETURN\n", uid);
+        }
+        cmd += "-A bw_happy_box -j bw_data_saver\n";
+    } else {
+        const char* name = legacyChainName(chain);
+        if (name == nullptr) return -EINVAL;
+        StringAppendF(&cmd, ":%s -\n", name);
+        if (legacyAllowlist(chain)) {
+            // iptables-restore's -6 prefix limits these exceptions to IPv6.
+            for (const char* type : ICMPV6_TYPES) {
+                StringAppendF(&cmd, "-6 -A %s -p icmpv6 --icmpv6-type %s -j RETURN\n", name, type);
+            }
+            StringAppendF(&cmd, "-A %s -m owner --uid-owner 0-9999 -j RETURN\n", name);
+        }
+        for (int uid : mLegacyUids[chain]) {
+            StringAppendF(&cmd, "-A %s -m owner --uid-owner %d -j %s\n", name, uid,
+                          legacyAllowlist(chain) ? "RETURN" : "REJECT");
+        }
+        if (legacyAllowlist(chain)) StringAppendF(&cmd, "-A %s -j REJECT\n", name);
+    }
+    cmd += "COMMIT\n";
+    if (execIptablesRestore(V4V6, cmd) != 0) return -EREMOTEIO;
+    for (int index = (chain >= 10 ? 10 : chain); index <= (chain >= 10 ? 12 : chain); index++) {
+        std::vector<int32_t> uids(mLegacyUids[index].begin(), mLegacyUids[index].end());
+        if (int error = libnetd_updatable_legacy_setUidChain(index, uids.data(), uids.size())) {
+            return error;
+        }
+    }
+    return 0;
+}
+
+int FirewallController::writeLegacyEnabled() {
+    std::string cmd = "*filter\n:fw_legacy -\n"
+                      "-A fw_legacy -m owner --uid-owner 0-9999 -j RETURN\n";
+    for (int chain : mLegacyEnabled) {
+        StringAppendF(&cmd, "-A fw_legacy -j %s\n", legacyChainName(chain));
+    }
+    cmd += "COMMIT\n";
+    if (execIptablesRestore(V4V6, cmd) != 0) return -EREMOTEIO;
+    uint32_t enabled = 0;
+    for (int chain : mLegacyEnabled) enabled |= 1U << chain;
+    return libnetd_updatable_legacy_setEnabledChains(enabled);
+}
+
+int FirewallController::setLegacyUidRule(int chain, int uid, FirewallRule rule) {
+    if (chain < 1 || chain > 12 || uid < 0 || (rule != ALLOW && rule != DENY)) return -EINVAL;
+    const auto old = mLegacyUids[chain];
+    const bool add = (rule == ALLOW) == legacyAllowlist(chain);
+    if (add) mLegacyUids[chain].insert(uid);
+    else mLegacyUids[chain].erase(uid);
+    const int result = writeLegacyChain(chain);
+    if (result) {
+        mLegacyUids[chain] = old;
+        if (writeLegacyChain(chain)) LOG(ERROR) << "Failed to restore legacy UID chain";
+    }
+    return result;
+}
+
+int FirewallController::enableLegacyChain(int chain, bool enable) {
+    if (legacyChainName(chain) == nullptr) return -EINVAL;
+    const auto old = mLegacyEnabled;
+    if (enable) mLegacyEnabled.insert(chain);
+    else mLegacyEnabled.erase(chain);
+    const int result = writeLegacyEnabled();
+    if (result) {
+        mLegacyEnabled = old;
+        if (writeLegacyEnabled()) LOG(ERROR) << "Failed to restore legacy chain activation";
+    }
+    return result;
+}
+
+int FirewallController::replaceLegacyUidChain(const std::string& name, bool allowlist,
+                                             const std::vector<int32_t>& uids) {
+    for (int chain = 1; chain <= 9; chain++) {
+        if (name != legacyChainName(chain)) continue;
+        if (allowlist != legacyAllowlist(chain)) return -EINVAL;
+        for (int uid : uids) if (uid < 0) return -EINVAL;
+        const auto old = mLegacyUids[chain];
+        mLegacyUids[chain] = std::set<int>(uids.begin(), uids.end());
+        int result = writeLegacyChain(chain);
+        if (result) {
+            mLegacyUids[chain] = old;
+            if (writeLegacyChain(chain)) LOG(ERROR) << "Failed to restore legacy UID chain";
+        }
+        return result;
+    }
+    return -EINVAL;
+}
+
+int FirewallController::writeLegacyInterfaces() {
+    std::string cmd = "*filter\n:fw_legacy_iif -\n-A fw_legacy_iif -i lo -j RETURN\n";
+    for (const auto& [uid, iface] : mLegacyInterfaces) {
+        if (!iface.empty()) {
+            StringAppendF(&cmd, "-A fw_legacy_iif ! -i %s -m owner --uid-owner %d -j DROP\n",
+                          iface.c_str(), uid);
+        }
+    }
+    cmd += "COMMIT\n";
+    return execIptablesRestore(V4V6, cmd) == 0 ? 0 : -EREMOTEIO;
+}
+
+int FirewallController::setLegacyUidInterfaces(const std::string& iface,
+                                              const std::vector<int32_t>& uids) {
+    if (!iface.empty() && !isIfaceName(iface.c_str())) return -EINVAL;
+    for (int uid : uids) if (uid < 0) return -EINVAL;
+    const auto old = mLegacyInterfaces;
+    for (int uid : uids) mLegacyInterfaces[uid] = iface;
+    const int result = writeLegacyInterfaces();
+    if (result) {
+        mLegacyInterfaces = old;
+        if (writeLegacyInterfaces()) LOG(ERROR) << "Failed to restore legacy interface rules";
+    }
+    return result;
+}
+
+int FirewallController::removeLegacyUidInterfaces(const std::vector<int32_t>& uids) {
+    const auto old = mLegacyInterfaces;
+    for (int uid : uids) mLegacyInterfaces.erase(uid);
+    const int result = writeLegacyInterfaces();
+    if (result) {
+        mLegacyInterfaces = old;
+        if (writeLegacyInterfaces()) LOG(ERROR) << "Failed to restore legacy interface rules";
+    }
+    return result;
+}
+
 }  // namespace net
 }  // namespace android
