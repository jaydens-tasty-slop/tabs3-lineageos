+bool isTabS3Wifi() {
+    char device[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.vendor.device", device, "");
+    return std::strcmp(device, "gts3lwifi") == 0 || std::strcmp(device, "gts3llte") == 0;
+}
+
+// The stock QCamera HAL has working UHD30 sensor, ISP and encoder paths, but
+// its initialized public picture-size table omits the mode on this device.
+// Patch only the already initialized back-camera cache, and only after its
+// exact ABI landmarks have been verified.
+bool patchTabS3UhdCapability(camera_module_t* module, int cameraId) {
+    if (cameraId != 0 || !isTabS3Wifi() || module->common.dso == nullptr) {
+        return false;
+    }
+
+    auto capabilities = reinterpret_cast<uint8_t**>(
+            dlsym(module->common.dso, "_ZN7qcamera14gCamCapabilityE"));
+    if (capabilities == nullptr || capabilities[cameraId] == nullptr) {
+        ALOGE("Tab S3 UHD30: initialized capability cache is unavailable");
+        return false;
+    }
+
+    struct Dimension {
+        int32_t width;
+        int32_t height;
+    };
+    constexpr size_t kPictureSizeCountOffset = 5736;
+    constexpr size_t kPictureSizesOffset = 5740;
+    constexpr size_t kPictureMinDurationsOffset = 6256;
+    constexpr size_t kJpegStallDurationsOffset = 19160;
+    constexpr size_t kActiveArrayOffset = 17680;
+    constexpr uint32_t kMaxPictureSizes = 64;
+    constexpr Dimension kUhd30 = {3840, 2160};
+    constexpr int64_t kUhd30FrameDurationNs = 33333333;
+    constexpr int64_t kUhdJpegStallDurationNs = 370000000;
+
+    uint8_t* capability = capabilities[cameraId];
+    auto count = reinterpret_cast<uint32_t*>(capability + kPictureSizeCountOffset);
+    auto sizes = reinterpret_cast<Dimension*>(capability + kPictureSizesOffset);
+    auto minDurations = reinterpret_cast<int64_t*>(capability + kPictureMinDurationsOffset);
+    auto jpegStallDurations =
+            reinterpret_cast<int64_t*>(capability + kJpegStallDurationsOffset);
+    auto activeArray = reinterpret_cast<Dimension*>(capability + kActiveArrayOffset);
+
+    if (*count == 0 || *count >= kMaxPictureSizes || activeArray->width != 4128 ||
+        activeArray->height != 3096 || sizes[0].width != 4128 || sizes[0].height != 3096) {
+        ALOGE("Tab S3 UHD30: unexpected initialized capability ABI "
+              "(count %u, active %dx%d, first %dx%d)",
+              *count, activeArray->width, activeArray->height, sizes[0].width, sizes[0].height);
+        return false;
+    }
+
+    for (uint32_t i = 0; i < *count; ++i) {
+        if (sizes[i].width == kUhd30.width && sizes[i].height == kUhd30.height) {
+            return true;
+        }
+    }
+
+    const uint32_t index = *count;
+    sizes[index] = kUhd30;
+    minDurations[index] = kUhd30FrameDurationNs;
+    jpegStallDurations[index] = kUhdJpegStallDurationNs;
+    ++*count;
+    return true;
+}
