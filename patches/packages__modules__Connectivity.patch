+
+/** Reads the cumulative xt_qtaguid counters instead of absent eBPF maps. */
+final class LegacyNetworkStats {
+    static boolean enabled() {
+        return !SystemProperties.getBoolean("ro.kernel.ebpf.supported", true);
+    }
+
+    static void writeCounterSet(int uid, int set) throws ErrnoException {
+        if (uid < 0 || set < 0 || set > 1) throw new ErrnoException("qtaguid counter set", OsConstants.EINVAL);
+        try (FileOutputStream output = new FileOutputStream("/proc/net/xt_qtaguid/ctrl")) {
+            output.write(("s " + set + " " + uid).getBytes(StandardCharsets.US_ASCII));
+        } catch (IOException e) {
+            throw new ErrnoException("qtaguid counter set", OsConstants.EIO, e);
+        }
+    }
+
+    static void deleteUid(int uid) throws IOException {
+        if (uid < 0) throw new IOException("Invalid accounting UID");
+        try (FileOutputStream output = new FileOutputStream("/proc/net/xt_qtaguid/ctrl")) {
+            output.write(("d 0 " + uid).getBytes(StandardCharsets.US_ASCII));
+        }
+    }
+
+    private static long counter(String value) throws IOException {
+        try {
+            long result = Long.parseLong(value);
+            if (result < 0) throw new NumberFormatException("negative counter");
+            return result;
+        } catch (NumberFormatException e) {
+            throw new IOException("Invalid xt_qtaguid counter", e);
+        }
+    }
+
+    static NetworkStats detail() throws IOException {
+        NetworkStats stats = new NetworkStats(SystemClock.elapsedRealtime(), 0);
+        try (BufferedReader input = new BufferedReader(new FileReader("/proc/net/xt_qtaguid/stats"))) {
+            String header = input.readLine();
+            if (header == null || !header.startsWith("idx iface ")) throw new IOException("Invalid xt_qtaguid header");
+            String line;
+            long lastIndex = 1;
+            while ((line = input.readLine()) != null) {
+                String[] fields = line.trim().split("\\s+");
+                if (fields.length < 9) throw new IOException("Truncated xt_qtaguid stats row");
+                long index = counter(fields[0]);
+                if (index != lastIndex + 1) throw new IOException("Inconsistent xt_qtaguid index");
+                lastIndex = index;
+                NetworkStats.Entry entry = new NetworkStats.Entry();
+                entry.iface = fields[1];
+                entry.uid = Math.toIntExact(counter(fields[3]));
+                entry.set = Math.toIntExact(counter(fields[4]));
+                entry.tag = NetworkStatsFactory.kernelToTag(fields[2]);
+                entry.rxBytes = counter(fields[5]);
+                entry.rxPackets = counter(fields[6]);
+                entry.txBytes = counter(fields[7]);
+                entry.txPackets = counter(fields[8]);
+                stats.combineValues(entry);
+            }
+        } catch (NumberFormatException | ArithmeticException e) {
+            throw new IOException("Invalid xt_qtaguid stats row", e);
+        }
+        return stats;
+    }
+
+    static NetworkStats interfaces() throws IOException {
+        NetworkStats stats = new NetworkStats(SystemClock.elapsedRealtime(), 6);
+        try (BufferedReader input = new BufferedReader(new FileReader("/proc/net/xt_qtaguid/iface_stat_all"))) {
+            String line;
+            while ((line = input.readLine()) != null) {
+                String[] fields = line.trim().split("\\s+");
+                if (fields.length < 10) throw new IOException("Truncated xt_qtaguid interface row");
+                NetworkStats.Entry entry = new NetworkStats.Entry();
+                entry.iface = fields[0];
+                entry.uid = NetworkStats.UID_ALL;
+                entry.set = NetworkStats.SET_ALL;
+                entry.tag = NetworkStats.TAG_NONE;
+                entry.rxBytes = counter(fields[2]);
+                entry.rxPackets = counter(fields[3]);
+                entry.txBytes = counter(fields[4]);
+                entry.txPackets = counter(fields[5]);
+                if (counter(fields[1]) != 0) {
+                    entry.rxBytes += counter(fields[6]);
+                    entry.rxPackets += counter(fields[7]);
+                    entry.txBytes += counter(fields[8]);
+                    entry.txPackets += counter(fields[9]);
+                }
+                stats.combineValues(entry);
+            }
+        }
+        return stats;
+    }
+
+    static NetworkStats.Entry total(String iface, int uid) {
+        try {
+            if (uid >= 0) return detail().getTotal(null, uid);
+            NetworkStats stats = interfaces();
+            if (iface == null) return stats.getTotal(null);
+            HashSet<String> names = new HashSet<>();
+            names.add(iface);
+            return stats.getTotal(null, names);
+        } catch (IOException e) {
+            android.util.Log.e("LegacyNetworkStats", "Unable to read kernel traffic counters", e);
+            return null; // TrafficStats' existing unsupported/error result.
+        }
+    }
+}
